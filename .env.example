# Copy to .env and edit
PORT=3000
# Name shown in the sidebar and on the sign-in page
APP_NAME=DRAAS REPORTS
# Title printed at the top of every PDF report
REPORT_TITLE=IronTree Simulation Report
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Set to true once you serve the app over HTTPS
COOKIE_SECURE=false
# Set to true if running behind a reverse proxy (nginx, Traefik, etc.)
TRUST_PROXY=false
# SQLite file location
DATABASE_PATH=./data/app.db
# First admin account, created by `npm run seed`
ADMIN_USERNAME=admin
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_PASSWORD=choose-a-strong-password

# ---- Screenshot storage ----
# "local" keeps files in UPLOAD_DIR on this machine. "s3" uses your S3-compatible server.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Only needed when STORAGE_DRIVER=s3. Test with: npm run check-storage
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=audit-screenshots
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Most private S3 servers need path-style URLs (https://host/bucket/key). Leave true unless told otherwise.
S3_FORCE_PATH_STYLE=true
# Optional folder inside the bucket, e.g. audit-app
S3_PREFIX=
# Only set to true if your server uses a self-signed certificate (less secure).
S3_ALLOW_SELF_SIGNED=false
