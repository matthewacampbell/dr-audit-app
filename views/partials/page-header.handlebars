    <div class="flex-grow-1">
      <div class="eyebrow">{{eyebrow}}</div>
      <h1 class="page-title">{{title}}</h1>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">{{> @partial-block}}</div>
  </div>
</div>
