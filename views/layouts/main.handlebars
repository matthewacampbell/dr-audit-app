<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} &middot; {{appName}}</title>
  <script src="/js/theme.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css" integrity="sha384-nWN3KqaaVcbEsCjLSV+2jMjh62Iny/+mN3srM8TZeM8N6aj7eDl5wwYggjAJ4/sJ" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/app.css">
  <meta name="csrf-token" content="{{csrfToken}}">
  <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
  <script src="/vendor/htmx/htmx.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous" defer></script>
  <script src="/js/app.js" defer></script>
  <script src="/js/forms.js" defer></script>
</head>
<body hx-headers='{"x-csrf-token": "{{csrfToken}}"}'>
{{#if user}}
<div class="app-shell">
  <aside class="sidebar-wrap">
    <div class="offcanvas-lg offcanvas-start sidebar" tabindex="-1" id="sidebar" aria-label="Main navigation">
      <div class="offcanvas-header sidebar-brand">
        <a href="/" class="brand"><i class="bi bi-layers-fill"></i><span>{{appName}}</span></a>
        <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Close"></button>
      </div>

      <div class="offcanvas-body sidebar-body">
        <nav class="sidebar-nav">
          <div class="nav-section">Workspace</div>

          <a class="nav-group" data-bs-toggle="collapse" href="#nav-audits" role="button" aria-expanded="true" aria-controls="nav-audits">
            <i class="bi bi-clipboard-check"></i><span>Audits</span><i class="bi bi-chevron-down ms-auto chev"></i>
          </a>
          <div class="collapse show nav-children" id="nav-audits">
            <a class="nav-child {{#if (eq nav "audits")}}active{{/if}}" href="/"><i class="bi bi-chevron-right"></i>All audits</a>
            <a class="nav-child {{#if (eq nav "audit-new")}}active{{/if}}" href="/reports/new"><i class="bi bi-chevron-right"></i>New audit</a>
          </div>

          <a class="nav-group" data-bs-toggle="collapse" href="#nav-companies" role="button" aria-expanded="true" aria-controls="nav-companies">
            <i class="bi bi-building"></i><span>Companies</span><i class="bi bi-chevron-down ms-auto chev"></i>
          </a>
          <div class="collapse show nav-children" id="nav-companies">
            <a class="nav-child {{#if (eq nav "companies")}}active{{/if}}" href="/companies"><i class="bi bi-chevron-right"></i>All companies</a>
            <a class="nav-child {{#if (eq nav "company-new")}}active{{/if}}" href="/companies/new"><i class="bi bi-chevron-right"></i>Add company</a>
          </div>

          <a class="nav-top {{#if (eq nav "procedure")}}active{{/if}}" href="/procedure"><i class="bi bi-list-check"></i><span>Procedure</span></a>

          {{#if (eq user.role "admin")}}
          <div class="nav-section">Administration</div>
          <a class="nav-top {{#if (eq nav "users")}}active{{/if}}" href="/admin/users"><i class="bi bi-people"></i><span>Users</span></a>
          {{/if}}
        </nav>

        <div class="user-box">
          <div class="avatar">{{user.initials}}</div>
          <div class="user-meta">
            <div class="user-name" title="{{user.displayName}}">{{user.displayName}}</div>
            <div class="user-role">{{user.roleLabel}}</div>
          </div>
          <button type="button" class="icon-btn" data-theme-toggle title="Switch light/dark theme" aria-label="Switch light/dark theme"><i class="bi bi-moon-stars"></i></button>
          <form method="post" action="/logout" class="m-0">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <button type="submit" class="icon-btn" title="Sign out" aria-label="Sign out"><i class="bi bi-box-arrow-right"></i></button>
          </form>
        </div>
      </div>
    </div>
  </aside>

  <div class="main-area">
    <header class="topbar d-lg-none">
      <button class="icon-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Open menu"><i class="bi bi-list"></i></button>
      <span class="brand"><i class="bi bi-layers-fill"></i><span>{{appName}}</span></span>
    </header>

    <main class="content">
      {{#if flash}}
      <div class="alert alert-{{flash.cls}} alert-dismissible fade show" role="alert">
        {{flash.message}}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
      {{/if}}
      {{{body}}}
    </main>
  </div>
</div>
{{else}}
<main class="auth-wrap">
  {{{body}}}
</main>
{{/if}}
</body>
</html>
