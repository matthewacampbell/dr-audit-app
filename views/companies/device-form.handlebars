{{#> page-header eyebrow=company.name title=heading icon="hdd-rack"}}{{/page-header}}

<div class="card">
  <div class="card-body">
    {{#if error}}<div class="alert alert-danger py-2" role="alert">{{error}}</div>{{/if}}
    <form method="post" action="{{action}}">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div class="mb-3">
        <label class="form-label" for="name">Device name</label>
        <input class="form-control" id="name" type="text" name="name" value="{{device.name}}" maxlength="100" required autofocus placeholder="e.g. FILE-SRV-01">
      </div>
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label" for="device_type">Type <span class="text-body-secondary fw-normal">(optional)</span></label>
          <input class="form-control" id="device_type" type="text" name="device_type" value="{{device.device_type}}" list="device-types" maxlength="50">
        </div>
        <div class="col-md-6">
          <label class="form-label" for="identifier">Serial / IP / hostname <span class="text-body-secondary fw-normal">(optional)</span></label>
          <input class="form-control" id="identifier" type="text" name="identifier" value="{{device.identifier}}" maxlength="100">
        </div>
      </div>
      <div class="mb-4">
        <label class="form-label" for="notes">Notes <span class="text-body-secondary fw-normal">(optional)</span></label>
        <textarea class="form-control" id="notes" name="notes" rows="3" maxlength="1000">{{device.notes}}</textarea>
      </div>
      <button type="submit" class="btn btn-primary">Save</button>
      <a class="btn btn-link text-body-secondary" href="/companies/{{company.id}}#devices">Cancel</a>
    </form>
    {{> device-types}}
  </div>
</div>
