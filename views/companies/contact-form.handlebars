{{#> page-header eyebrow=company.name title=heading icon="person-lines-fill"}}{{/page-header}}

<div class="card">
  <div class="card-body">
    {{#if error}}<div class="alert alert-danger py-2" role="alert">{{error}}</div>{{/if}}
    <form method="post" action="{{action}}">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label" for="name">Name</label>
          <input class="form-control" id="name" type="text" name="name" value="{{contact.name}}" maxlength="100" required autofocus>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="role">Role <span class="text-body-secondary fw-normal">(optional)</span></label>
          <input class="form-control" id="role" type="text" name="role" value="{{contact.role}}" maxlength="100" placeholder="e.g. IT manager">
        </div>
        <div class="col-md-6">
          <label class="form-label" for="email">Email <span class="text-body-secondary fw-normal">(optional)</span></label>
          <input class="form-control" id="email" type="email" name="email" value="{{contact.email}}" maxlength="150">
        </div>
        <div class="col-md-6">
          <label class="form-label" for="phone">Phone <span class="text-body-secondary fw-normal">(optional)</span></label>
          <input class="form-control" id="phone" type="text" name="phone" value="{{contact.phone}}" maxlength="50">
        </div>
      </div>
      <div class="mb-4">
        <label class="form-label" for="notes">Notes <span class="text-body-secondary fw-normal">(optional)</span></label>
        <textarea class="form-control" id="notes" name="notes" rows="3" maxlength="500">{{contact.notes}}</textarea>
      </div>
      <button type="submit" class="btn btn-primary">Save</button>
      <a class="btn btn-link text-body-secondary" href="/companies/{{company.id}}#contacts">Cancel</a>
    </form>
  </div>
</div>
